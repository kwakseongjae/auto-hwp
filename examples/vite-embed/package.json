{
  "name": "auto-hwp-vite-embed",
  "version": "0.0.0",
  "private": true,
  "description": "외부 호스트 이식 증명 (issue 063): 레지스트리 발행본(@auto-hwp/* ^0.0.3)을 설치해 비-Next Vite 앱에서 <HwpWorkspace/>를 렌더한다. 소스경로 import 0. REPO_DEV=1 이면 로컬 tarball 로 덮어쓴다.",
  "type": "module",
  "scripts": {
    "pack-deps": "node scripts/pack-deps.mjs",
    "use-local": "node scripts/prepare-deps.mjs --force",
    "copy-assets": "node scripts/copy-assets.mjs",
    "predev": "node scripts/prepare-deps.mjs && node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-deps.mjs && node scripts/copy-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auto-hwp/ai-protocol": "^0.0.3",
    "@auto-hwp/editor-core": "^0.0.3",
    "@auto-hwp/engine": "^0.0.3",
    "@auto-hwp/react": "^0.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
