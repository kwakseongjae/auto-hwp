/target
**/*.rs.bk
Cargo.lock.bak
.DS_Store

# build / tooling
/dist
/pkg
node_modules/
# Tauri-generated capability schemas (regenerated by tauri-build on every build)
crates/hwp-viewer/gen/schemas/
__pycache__/

# oracle / test scratch
/tmp
*.pdf.tmp
/corpus/private/
/out

# 로컬 벤치 반입구(scripts/bench-local.sh) — 기여자가 자기 공문서를 넣는 곳.
# 문서도 리포트도 절대 커밋되지 않는다. 안내 README 만 추적한다.
/benchmarks/local/*
!/benchmarks/local/README.md

# secrets — BYOK keys (OpenRouter/Anthropic). NEVER commit. .env.example is the committed template.
.env
.env.local

# apps/hwp-lab (issue 019) — Next.js build + copied artifacts. wasm/fonts are NOT committed as
# binaries; copy-wasm.mjs (prebuild/predev) fills public/hwp from packages/engine/pkg.
apps/hwp-lab/.next/
apps/hwp-lab/out/
apps/hwp-lab/public/hwp/
apps/hwp-lab/public/fonts/
apps/hwp-lab/public/samples/
apps/hwp-lab/.demo-api-hold/
apps/hwp-lab/.turbo/
apps/hwp-lab/tsconfig.tsbuildinfo
apps/hwp-lab/next-env.d.ts
apps/hwp-lab/test-results/
apps/hwp-lab/playwright-report/
apps/hwp-lab/playwright/.cache/

# Vercel CLI 로컬 상태 — 링크된 프로젝트 id + `vercel pull` 이 받아 온 env(.env.*.local)와
# `vercel build` 산출물(output/). 전부 머신 로컬이고 env 사본에는 시크릿이 들어온다 — 절대 커밋 금지.
.vercel/

# local agent runtime state (공유 훅 settings.json만 추적)
.claude/*
!.claude/settings.json

# editor
.idea/
.vscode/
