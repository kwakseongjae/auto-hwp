{
  "name": "@auto-hwp/react",
  "version": "0.0.4",
  "description": "React components for auto-hwp: open .hwp/.hwpx, render pages to SVG, mark cells/ranges, chat-edit via a host-supplied AI callback, and download HTML/PDF — one <HwpWorkspace/> line. No LLM, no keys, no bundled fonts.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "pack:safe": "node scripts/with-publish-deps.mjs pack",
    "publish:safe": "node scripts/with-publish-deps.mjs publish",
    "prepack": "node scripts/require-safe-pack.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:gate": "node scripts/check-i18n-literals.mjs",
    "i18n:list": "node scripts/check-i18n-literals.mjs --list",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@auto-hwp/editor-core": "file:../editor-core",
    "@auto-hwp/engine": "file:../engine"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "keywords": ["hwp", "hwpx", "hancom", "react", "svg", "pdf", "viewer", "chat", "document"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
