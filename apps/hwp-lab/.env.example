# auto-hwp lab — BYOK LLM 키 (바이브 편집 생성). 이 파일은 커밋되는 "템플릿"이다.
# 실제 키는 이 파일을 복사한 `.env.local`(gitignore됨)에 넣는다:  cp .env.example .env.local
# Next.js가 `.env.local`을 자동 로드한다(서버 전용 — NEXT_PUBLIC_ 접두사 없으므로 클라 번들 미포함, R6).
# 프로바이더 우선순위: OPENROUTER_API_KEY(있으면) → ANTHROPIC_API_KEY → mock(키 없으면).

# ── OpenRouter (권장, Grok) ──────────────────────────────────────────────
# https://openrouter.ai/keys 에서 발급. 키 하나로 여러 모델 라우팅.
OPENROUTER_API_KEY=

# default 모델 = x-ai/grok-4.5. 바꾸려면 정확한 OpenRouter 슬러그로 override(주석 해제).
# ("grok 4.2"는 OpenRouter에 없음 — 실제 슬러그는 grok-4.20 / grok-4.3 / grok-4.5)
# AUTO_HWP_OPENROUTER_MODEL=x-ai/grok-4.20

# ── Anthropic (폴백) ─────────────────────────────────────────────────────
# OPENROUTER_API_KEY가 없을 때만 사용(모델 claude-opus-4-8).
# ANTHROPIC_API_KEY=

# ── 공개 데모 모드 (Vercel full-Next 배포용 — src/app/api/hwp-edit/demo.ts) ─────────────────────
# 로컬 개발에는 전부 불필요하다(BYOK 기본). 아래를 켜면 /api/hwp-edit 가 하드닝된 데모 경로로
# 바뀐다: 모델·max_tokens·reasoning·zdr 서버 고정 + 입력 상한 + same-origin + IP 캡
# (일일 전역 캡은 기본 꺼짐 — 아래 DEMO_AI_DAILY_CAP 참조).
#
# ⚠️ 공개 배포에 OPENROUTER_API_KEY를 넣는다면 DEMO_AI_MODE=1은 선택이 아니라 **필수**다.
#    빠뜨리면 BYOK 경로(웹검색 툴콜·한도 없음)가 인증 없이 공개된다.
# DEMO_AI_MODE=1
#
# 클라이언트 스위치(빌드 타임). `route`면 워커 URL 없이 same-origin /api/hwp-edit를 데모 계약
# (첫 요청 전 동의 게이트 + 단발 + 한도)으로 호출한다. 정적 데모(Pages)는 대신 워커 URL을 쓴다.
# NEXT_PUBLIC_DEMO_AI=route
# NEXT_PUBLIC_DEMO_AI_URL=https://<worker>.workers.dev   # (Pages 경로 — route 모드와 함께 쓰지 않는다)
#
# 서버 고정 파라미터(전부 선택 — 기본값이 곧 계약):
# DEMO_AI_MODEL=openai/gpt-5.6-luna      # (별칭 MODEL — 워커와 같은 이름)
# DEMO_AI_MAX_TOKENS=4096                # 상한이자 기본값
# DEMO_AI_REASONING_EFFORT=low           # ""로 두면 reasoning 필드 자체를 안 보냄(롤백)
# DEMO_AI_DAILY_CAP=                     # 일일 전역 캡 — **기본 비활성(무제한)**. 비용이 커지면 여기에
#                                        #   숫자를 넣어 되켠다: 최악 ≈ $0.0037/건 → 1300 ≈ $4.8/일.
# DEMO_AI_PER_IP_CAP=20                  # IP 캡(상시·기본 방어선). IP 하나당 하루 최악 20 × $0.0037 ≈ $0.074
# DEMO_AI_ALLOWED_ORIGIN=https://foo.vercel.app   # same-origin 외 추가 허용(콤마 구분, 보통 불필요)
#
# 캡 저장소: Upstash Redis(REST)가 있으면 durable, 없으면 인메모리 best-effort
# (서버리스 인스턴스마다 별도 카운터 — 실제 허용량이 "캡 × 인스턴스 수"까지 샌다. 예산이 걸린
#  공개 배포에는 반드시 Upstash를 붙일 것).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
